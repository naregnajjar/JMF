{
  "name": "jmf",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write \"**/*.{html,css,js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{html,css,js,jsx,ts,tsx,json,md}\"",
    "lint": "npm --prefix web run lint && npm --prefix studio run lint",
    "check": "npm run format:check && npm run lint"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2"
  },
  "lint-staged": {
    "**/*.{html,css,js,jsx,ts,tsx,json,md}": "prettier --write",
    "web/**/*.{js,jsx,ts,tsx}": "npm --prefix web run lint -- --fix",
    "studio/**/*.{js,jsx,ts,tsx}": "npm --prefix studio run lint -- --fix"
  }
}
